rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function slipOk(s) {
      return s is map
        && s.keys().hasOnly(['id', 'number', 'nickname', 'caption', 'carrier'])
        && s.id is string
        && s.id.size() > 0
        && s.id.size() <= 80
        && s.number is string
        && s.number.size() >= 8
        && s.number.size() <= 40
        && s.number.matches('^[A-Za-z0-9]+$')
        && s.nickname is string
        && s.nickname.size() <= 40
        && s.caption is string
        && s.caption.size() <= 140
        && s.carrier in ['usps', 'ups', 'fedex', 'dhl', 'hdx', 'ontrac'];
    }

    function slipsOk(slips) {
      return slips is list
        && slips.size() <= 12
        && (slips.size() < 1 || slipOk(slips[0]))
        && (slips.size() < 2 || slipOk(slips[1]))
        && (slips.size() < 3 || slipOk(slips[2]))
        && (slips.size() < 4 || slipOk(slips[3]))
        && (slips.size() < 5 || slipOk(slips[4]))
        && (slips.size() < 6 || slipOk(slips[5]))
        && (slips.size() < 7 || slipOk(slips[6]))
        && (slips.size() < 8 || slipOk(slips[7]))
        && (slips.size() < 9 || slipOk(slips[8]))
        && (slips.size() < 10 || slipOk(slips[9]))
        && (slips.size() < 11 || slipOk(slips[10]))
        && (slips.size() < 12 || slipOk(slips[11]));
    }

    function wallOk(data) {
      return data.keys().hasOnly(['slips', 'updatedAt'])
        && slipsOk(data.slips)
        && data.updatedAt is timestamp;
    }

    match /walls/{uid} {
      allow read: if signedInOwner(uid);
      allow create, update: if signedInOwner(uid) && wallOk(request.resource.data);
      allow delete: if signedInOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
