# Copy to `.env.local` for local development. Leave these unset to keep the
# wall local-only (localStorage + #w= share links, no auth UI).
#
# Vite inlines VITE_* at build time. On Vercel, set them in
# Project Settings → Environment Variables and redeploy after changes.
# Do not commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local Firebase emulators only. Never set these on Vercel.
# Auth handler proxy is not used while these point at the emulators.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
