# Copy to `.env.local` for local development. Leave these unset to keep the
# wall local-only (localStorage + #w= share links, no auth UI).
#
# Vite inlines VITE_* at build time. On Vercel, set them in
# Project Settings → Environment Variables and redeploy after changes.
# Do not commit real values.
#
# Production project is waybill-wall (475380620738). Those values are
# already on Vercel. AUTH_DOMAIN must be the site host, not
# waybill-wall.firebaseapp.com, or Google redirect fails on Android Chrome
# and in the installed PWA:
#   VITE_FIREBASE_AUTH_DOMAIN=waybill-wall.vercel.app
#   VITE_FIREBASE_PROJECT_ID=waybill-wall
#   VITE_FIREBASE_STORAGE_BUCKET=waybill-wall.firebasestorage.app
#   VITE_FIREBASE_MESSAGING_SENDER_ID=475380620738
#   VITE_FIREBASE_APP_ID=1:475380620738:web:e080a1baef35c700e18a5b

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local Firebase emulators only. Never set these on Vercel.
# Auth handler proxy is not used while these point at the emulators.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
